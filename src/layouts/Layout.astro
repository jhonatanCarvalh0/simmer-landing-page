---
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="pt-PT" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		
		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />

		<!-- Dynamic Theme Resolver (Avoid FOUC) -->
		<script is:inline>
			const getTheme = () => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				return 'theme-dark'; // default theme is dark as in original HTML
			};
			const theme = getTheme();
			document.documentElement.className = theme;
		</script>
	</head>
	<body class="bg-custom-main text-custom-main min-h-screen overflow-x-hidden">
		<!-- Efeito de Luz Simmering ao Fundo -->
		<div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-[600px] pointer-events-none overflow-hidden z-0">
			<div class="simmer-radial-glow absolute -top-40 left-1/4 w-[600px] h-[600px] rounded-full bg-pink-500/10 blur-[120px]"></div>
			<div class="simmer-radial-glow absolute -top-20 right-1/4 w-[500px] h-[500px] rounded-full bg-purple-500/10 blur-[100px] delay-1000"></div>
		</div>

		<slot />
	</body>
</html>
