---
---

<!-- Seção Portfólio de Produtos -->
<section id="produtos" class="py-24 border-t border-custom relative z-10 transition-all-custom">
    <div class="max-w-7xl mx-auto px-6">
        <div class="text-center max-w-3xl mx-auto mb-16">
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-custom-accent/15 text-custom-accent border border-custom-accent/25 text-xs font-bold uppercase tracking-widest mb-4">
                <span class="w-2 h-2 rounded-full bg-custom-accent animate-pulse"></span>
                Ecossistema Simmer Systems
            </div>
            <h2 class="text-3xl md:text-5xl font-black tracking-tight text-custom-main">
                Portfólio de Produtos & Soluções
            </h2>
            <p class="text-custom-muted mt-4 text-sm md:text-base leading-relaxed">
                Do legado fundacional às engines de última geração. Conheça as ferramentas desenvolvidas sob a filosofia de maturação profunda e rigidez operacional.
            </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <!-- 1. Axiom -->
            <div class="p-8 rounded-3xl border-2 border-custom-accent/40 bg-custom-surface/90 hover:border-custom-accent hover:shadow-2xl hover:shadow-custom-accent/10 transition-all duration-300 flex flex-col justify-between relative group">
                <div class="absolute -top-3 left-6 bg-custom-accent text-custom-main px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-widest flex items-center gap-1.5 shadow-md">
                    <span class="w-1.5 h-1.5 rounded-full bg-custom-main animate-ping"></span>
                    Sucessor em Desenvolvimento
                </div>
                
                <div class="pt-2">
                    <div class="text-xs code-font text-custom-accent mb-2 uppercase tracking-wider">// MOTOR JURÍDICO & TRIBUTÁRIO</div>
                    <h3 class="text-2xl font-black text-custom-main flex items-center gap-2">
                        Módulo Axiom
                    </h3>
                    <p class="text-xs text-custom-muted mt-2 leading-relaxed">
                        Carro-chefe da Simmer Systems. Motor de alta performance para escritórios de advocacia tributária, unificando consultas fiscais, SELIC e prazos.
                    </p>

                    <hr class="border-custom my-6">

                    <ul class="space-y-3 text-xs text-custom-main">
                        <li class="flex items-center gap-2.5">
                            <span class="w-1.5 h-1.5 rounded-full bg-custom-accent"></span>
                            <span>Integração e-CAC & Procurações RFB</span>
                        </li>
                        <li class="flex items-center gap-2.5">
                            <span class="w-1.5 h-1.5 rounded-full bg-custom-accent"></span>
                            <span>Cálculos tributários automáticos (SELIC)</span>
                        </li>
                        <li class="flex items-center gap-2.5">
                            <span class="w-1.5 h-1.5 rounded-full bg-custom-accent"></span>
                            <span>Alertas de intimações fiscais do CARF & TRF1</span>
                        </li>
                        <li class="flex items-center gap-2.5">
                            <span class="w-1.5 h-1.5 rounded-full bg-custom-accent"></span>
                            <span>Gestão de Honorários, Precatórios e RPV</span>
                        </li>
                    </ul>
                </div>

                <div class="mt-8 pt-6 border-t border-custom flex flex-col gap-3">
                    <a 
                        href="https://simmer-axiom.vercel.app/" 
                        target="_blank" 
                        rel="noopener noreferrer"
                        class="w-full py-3 px-4 bg-custom-accent text-custom-main font-bold rounded-xl text-xs uppercase tracking-wider hover:opacity-90 transition-all-custom flex items-center justify-center gap-2 shadow-lg group-hover:scale-[1.01]"
                    >
                        <span>Acessar Axiom</span>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                    </a>
                </div>
            </div>

            <!-- 2. Pasep Reviewer -->
            <div class="p-8 rounded-3xl border border-custom bg-custom-surface/70 hover:border-emerald-500/50 hover:bg-custom-card/40 transition-all duration-300 flex flex-col justify-between relative group">
                <div class="absolute -top-3 left-6 bg-emerald-500 text-white px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-widest flex items-center gap-1.5 shadow-md">
                    <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
                    Sistema Ativo
                </div>

                <div class="pt-2">
                    <div class="text-xs code-font text-emerald-400 mb-2 uppercase tracking-wider">// AUDITORIA & RECÁLCULO</div>
                    <h3 class="text-2xl font-black text-custom-main flex items-center gap-2">
                        Pasep Reviewer
                    </h3>
                    <p class="text-xs text-custom-muted mt-2 leading-relaxed">
                        Ferramenta especializada para auditoria, apuração de desfalques e recálculo monetário de contas do PASEP para servidores públicos.
                    </p>

                    <hr class="border-custom my-6">

                    <ul class="space-y-3 text-xs text-custom-main">
                        <li class="flex items-center gap-2.5">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                            <span>Auditoria automatizada de extratos PASEP</span>
                        </li>
                        <li class="flex items-center gap-2.5">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                            <span>Recálculo com índices e correções oficiais</span>
                        </li>
                        <li class="flex items-center gap-2.5">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                            <span>Identificação de lacunas de repasses fiscais</span>
                        </li>
                        <li class="flex items-center gap-2.5">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                            <span>Exportação de laudos periciais para ação judiciária</span>
                        </li>
                    </ul>
                </div>

                <div class="mt-8 pt-6 border-t border-custom flex flex-col gap-3">
                    <a 
                        href="https://pasep-reviewer.vercel.app/" 
                        target="_blank" 
                        rel="noopener noreferrer"
                        class="w-full py-3 px-4 bg-emerald-600 hover:bg-emerald-500 text-white font-bold rounded-xl text-xs uppercase tracking-wider transition-all-custom flex items-center justify-center gap-2 shadow-lg group-hover:scale-[1.01]"
                    >
                        <span>Acessar Pasep Reviewer</span>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                    </a>
                </div>
            </div>

            <!-- 3. Veritas -->
            <div class="p-8 rounded-3xl border border-custom/60 bg-custom-surface/40 hover:border-custom/80 transition-all duration-300 flex flex-col justify-between relative group opacity-90 hover:opacity-100">
                <div class="absolute -top-3 left-6 bg-slate-700 text-slate-200 px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-widest flex items-center gap-1.5 shadow-md">
                    <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                    Predecessor Descontinuado
                </div>

                <div class="pt-2">
                    <div class="text-xs code-font text-slate-400 mb-2 uppercase tracking-wider">// PLATAFORMA LEGADO</div>
                    <h3 class="text-2xl font-black text-custom-main flex items-center gap-2">
                        Portal Veritas
                    </h3>
                    <p class="text-xs text-custom-muted mt-2 leading-relaxed">
                        Plataforma pioneira de consulta e organização jurídica preliminar. Serviu como a fundação conceitual para a arquitetura atual da Simmer.
                    </p>

                    <hr class="border-custom my-6">

                    <ul class="space-y-3 text-xs text-custom-muted">
                        <li class="flex items-center gap-2.5">
                            <span class="w-1.5 h-1.5 rounded-full bg-slate-500"></span>
                            <span>Mapeamento original de processos jurídicos</span>
                        </li>
                        <li class="flex items-center gap-2.5">
                            <span class="w-1.5 h-1.5 rounded-full bg-slate-500"></span>
                            <span>Protótipo de validação de rigidez operacional</span>
                        </li>
                        <li class="flex items-center gap-2.5">
                            <span class="w-1.5 h-1.5 rounded-full bg-slate-500"></span>
                            <span>Fundação conceitual para o Módulo Axiom</span>
                        </li>
                        <li class="flex items-center gap-2.5 italic">
                            <span class="w-1.5 h-1.5 rounded-full bg-slate-500"></span>
                            <span>Status: Descontinuado (Preservado para histórico)</span>
                        </li>
                    </ul>
                </div>

                <div class="mt-8 pt-6 border-t border-custom flex flex-col gap-3">
                    <a 
                        href="https://portal-veritas.vercel.app/" 
                        target="_blank" 
                        rel="noopener noreferrer"
                        class="w-full py-3 px-4 bg-custom-card border border-custom text-custom-main font-bold rounded-xl text-xs uppercase tracking-wider hover:bg-custom-main transition-all-custom flex items-center justify-center gap-2"
                    >
                        <span>Ver Veritas (Legado)</span>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
