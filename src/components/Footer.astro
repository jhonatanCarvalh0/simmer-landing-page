---
---
<!-- Rodapé -->
<footer class="border-t border-custom bg-[#07090b] py-12 px-6 relative z-10 transition-all-custom">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6 text-sm">
        <div class="flex items-center gap-3">
            <!-- Logotipo Vencedor no Rodapé -->
            <div class="w-8 h-8 flex items-center justify-center">
                <svg class="w-full h-full text-custom-accent" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="24" y="32" width="12" height="36" rx="3.5" fill="currentColor"/>
                    <rect x="44" y="24" width="12" height="52" rx="3.5" class="fill-custom-accent"/>
                    <rect x="64" y="32" width="12" height="36" rx="3.5" fill="currentColor"/>
                </svg>
            </div>
            <span class="font-bold text-custom-main">Simmer Systems</span>
        </div>

        <!-- Links Rápidos de Produtos -->
        <div class="flex flex-wrap justify-center items-center gap-6 text-xs text-custom-muted">
            <a href="https://simmer-axiom.vercel.app/" target="_blank" rel="noopener noreferrer" class="hover:text-custom-accent transition-all-custom flex items-center gap-1">
                <span>Axiom</span>
                <span class="text-[9px] px-1 py-0.2 rounded bg-custom-accent/15 text-custom-accent">Dev</span>
            </a>
            <a href="https://pasep-reviewer.vercel.app/" target="_blank" rel="noopener noreferrer" class="hover:text-emerald-400 transition-all-custom flex items-center gap-1">
                <span>Pasep Reviewer</span>
                <span class="text-[9px] px-1 py-0.2 rounded bg-emerald-500/15 text-emerald-400">Live</span>
            </a>
            <a href="https://portal-veritas.vercel.app/" target="_blank" rel="noopener noreferrer" class="hover:text-slate-300 transition-all-custom flex items-center gap-1">
                <span>Veritas</span>
                <span class="text-[9px] px-1 py-0.2 rounded bg-slate-800 text-slate-400">Legado</span>
            </a>
        </div>

        <p class="text-custom-muted text-xs text-center md:text-left">
            &copy; 2026 Simmer Systems. Todos os direitos reservados. Porto Velho - RO.
        </p>
    </div>
</footer>
